# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/disumprevies

# Logging
# Allowed values: debug | info | warn | error  (default: info)
LOG_LEVEL=info

# Environment
# Allowed values: development | production | test  (default: development)
NODE_ENV=development

# Docker Compose only (not used by the bot directly)
# These are used to construct DATABASE_URL inside docker-compose.yml
POSTGRES_USER=disumprevies
POSTGRES_PASSWORD=changeme
POSTGRES_DB=disumprevies
